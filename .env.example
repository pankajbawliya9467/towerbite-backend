# ---- Server ----
PORT=4000
# Comma separated list of apps allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ---- Supabase (Project Settings → API / Database) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database → Connection string → "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional but recommended: Supabase → Database → Settings → SSL Configuration → Download certificate.
# Paste the certificate text here (or a path to the .crt file) so the database's identity is fully checked.
DATABASE_CA_CERT=
# Storage bucket for menu and cafe photos (created automatically by db:migrate)
STORAGE_BUCKET=menu-images

# How many proxies are in front of the API (Render / Railway = 1, Cloudflare in front of them = 2).
# Used to read the real client IP for rate limits; a wrong (too high) number lets clients fake their IP.
TRUST_PROXY=1
# Employees must log in with a phone number starting with one of these (comma separated, empty = any).
ALLOWED_PHONE_PREFIXES=+91

# ---- Local development only ----
# When true the API accepts "dev:<phone or email>" tokens, so you can try every app before setting up
# SMS / email login. Only works with `npm run dev`; `npm start` (the production build) refuses to start with it.
DEV_AUTH=false
