# ---- Server ----
PORT=4000
# Comma separated list of apps allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ---- Database: any PostgreSQL 14+ (hosted or your own server) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional but recommended for a hosted database: its CA certificate (text, or a path to the .crt file),
# so the database's identity is fully checked.
DATABASE_CA_CERT=
# Your own Postgres on a private network without SSL: set to false. Keep empty for hosted databases.
DATABASE_SSL=

# ---- Image storage (menu and cafe photos). Backend only: never put these keys in the apps. ----
# Today photos are stored in a hosted storage bucket; leave empty and uploads are switched off.
STORAGE_URL=
STORAGE_SERVICE_KEY=
STORAGE_BUCKET=menu-images

# How many proxies are in front of the API (Render / Railway = 1, Cloudflare in front of them = 2).
# Used to read the real client IP for rate limits; a wrong (too high) number lets clients fake their IP.
TRUST_PROXY=1
# Employees must log in with a phone number starting with one of these (comma separated, empty = any).
ALLOWED_PHONE_PREFIXES=+91

# Login SMS through 2Factor.in (our API makes and checks the code; 2Factor only delivers it).
# API key: 2Factor dashboard. Template: the name of your DLT-approved OTP template there.
# With TWOFACTOR_API_KEY set, OTP_PROVIDER defaults to 2factor .
OTP_PROVIDER=
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=

# ---- Local development only ----
# When true the API accepts "dev:<phone or email>" tokens, so you can try every app before setting up
# SMS / email login. Only works with `npm run dev`; `npm start` (the production build) refuses to start with it.
DEV_AUTH=false

# Test login without SMS (testers, Play Store reviewer). Only these numbers can log in with TEST_LOGIN_OTP;
# everyone else gets a real SMS code. Leave TEST_LOGIN_NUMBERS empty to turn it off.
TEST_LOGIN_NUMBERS=
TEST_LOGIN_OTP=123456
# Short testing period: EVERY Indian number can log in with TEST_LOGIN_OTP until this date (max 45 days ahead).
# Anyone can then open any account, so never leave this on once real customers use the app.
TEST_LOGIN_ALL_UNTIL=
# Production ignores TEST_LOGIN_ALL_UNTIL unless this is true (only for a closed test without real customers).
ALLOW_OPEN_TEST_LOGIN=

# ---- Abuse and push ----
# Login SMS per day for all numbers together (SMS pause when reached). Default 3000.
OTP_DAILY_LIMIT=
# Expo access token (Expo → Enhanced push security). Only our server can then send pushes to our app.
EXPO_ACCESS_TOKEN=

# AI notification ideas. The OpenAI key is normally added in Admin -> AI settings (stored encrypted).
# SETTINGS_SECRET encrypts it: any long random string; keep it the same, or the key must be entered again.
SETTINGS_SECRET=
# Optional: a key here is used when none is saved in Admin.
OPENAI_API_KEY=
# No promo pushes in these IST hours (start-end, default 21-9). "off" turns it off.
QUIET_HOURS=21-9
# false = stop accepting old Supabase app logins (after everyone has the app from 15 Nov 2026 or newer).
LEGACY_SUPABASE_TOKENS=

