{
  "name": "towerbites-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "db:demo": "tsx scripts/demo-orders.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
